# Optional configuration overlay file. The packaged default remains config/default.yaml.
CVF_CONFIG_FILE=config/development.yaml

# Any setting can be overridden with double-underscore-separated keys.
CVF__APP__ENVIRONMENT=development
CVF__LOGGING__LEVEL=INFO
CVF__STORAGE__DATABASE_URL=sqlite+aiosqlite:///data/cvf.db

# CVF-01 phase 1 uses public market-data plans only. No trading API keys are accepted.

